# HyScribe configuration. The setup wizard (in the browser on the first
# start, or ./hyscribe setup in the terminal) writes .env from an existing
# site's wp-config.php; or copy this to .env next to the binary, then
# chmod 600 .env.
# Real environment variables override these values. Yes or no keys take
# true, yes, on or 1, and false, no, off or 0, in any case.
# docs/configuration.md in the release archive explains every key.

# Database (same values as wp-config.php). A Unix socket is given as in
# wp-config.php, DB_HOST=localhost:/run/mysqld/mysqld.sock, and DB_PORT is
# then not used.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_PREFIX=wp_
DB_CHARSET=utf8mb4

# Optional: a database user granted only SELECT, which then serves every
# read and all of shadow mode, so a fault in a read cannot write.
# DB_READ_USER=wordpress_read
# DB_READ_PASSWORD=

# HTTP listener. 127.0.0.1 keeps the site private until a proxy is in front.
BIND_HOST=127.0.0.1
PORT=8080
BEHIND_PROXY=false

# With BEHIND_PROXY on: the peers X-Forwarded-For is believed from, a comma
# list of IP addresses or CIDR ranges. Any other peer counts as its own
# address, so a client reaching the port directly cannot name its address.
# TRUSTED_PROXIES=127.0.0.1,::1

# Seconds a request may run. Past it the request answers 503 and an
# unfinished write rolls back. Cron and the mail queue are not cut by it.
# REQUEST_TIME_LIMIT=30

# shadow: read only, never writes (default). primary: serves and writes.
MODE=shadow

# Existing sites only: the WordPress uploads folder, left where it is
# (the wizard takes it from a literal UPLOADS in wp-config.php).
# UPLOADS_DIR=/var/www/wordpress/wp-content/uploads

# Overrides the site address stored in the database, like WP_HOME in
# wp-config.php. Useful to try a copy of a site on another address.
# WP_HOME=http://127.0.0.1:8080

# Overrides the stored WordPress address, like WP_SITEURL in wp-config.php.
# An https address marks login cookies secure.
# WP_SITEURL=http://127.0.0.1:8080

# The public users REST endpoint (/wp-json/wp/v2/users), which lists every
# user with published posts to visitors, as WordPress does. off answers
# visitors as a site where no user has published posts.
REST_PUBLIC_USERS=on

# Fetches from other sites (ADR 0019), such as the editor's link previews:
# on lets the server make them, to public addresses only; off makes none.
HTTP_OUTBOUND=off

# The hosts the RSS block may fetch feeds from, comma separated (names
# only: no scheme, port or path). Empty by default: every feed renders as
# one that cannot be reached. Needs HTTP_OUTBOUND=on.
RSS_ALLOWED_HOSTS=

# Where embeds (oEmbed) may fetch from, comma separated. Default: the
# providers of WordPress's list (YouTube, Vimeo and so on). Add hosts
# after "providers" to allow them too, with discovery of their pages
# (providers,media.example.org); hosts alone replace the providers; none
# allows nothing. A URL outside the list stays a plain link and is never
# fetched. Names only: no scheme, port or path. Needs HTTP_OUTBOUND=on.
EMBED_ALLOWED_HOSTS=providers

# minisign public keys trusted for extension packages you build yourself,
# comma separated (ADR 0024): hyscribe plugin install takes a package whose
# <file>.minisig one of them signed. Empty by default.
EXTENSION_TRUSTED_KEYS=

# The hosted registry hyscribe plugin install <name> and hyscribe plugin
# update fetch from (ADR 0024): an https: URL, a mirror or a registry of
# one's own, still checked against the root keys compiled into the binary.
# Not set by default until the project's registry has its address.
# EXTENSION_REGISTRY=https://registry.example/

# on makes the service fetch the registry's key list and index at its start
# and every 12 hours (ADR 0024), stopping extensions the registry revoked;
# it installs nothing and sends nothing about the site. Needs
# HTTP_OUTBOUND=on and EXTENSION_REGISTRY.
EXTENSION_UPDATE_CHECK=off

# The wp-config.php constants capability checks read, copied from
# wp-config.php. Missing means the safer value shown. MULTISITE=true is refused: multisite networks are not supported.
# DISALLOW_UNFILTERED_HTML=true
# ALLOW_UNFILTERED_UPLOADS=false
# MULTISITE=false

# WP-Cron, copied from wp-config.php: true or false (1 or 0). In primary
# mode the service runs the due events of WordPress's core jobs once a
# minute, sharing PHP's doing_cron lock. DISABLE_WP_CRON=true turns that
# off; run ./hyscribe cron run from the system's cron instead.
# ALTERNATE_WP_CRON is accepted and ignored.
# DISABLE_WP_CRON=false
# ALTERNATE_WP_CRON=false

# EMPTY_TRASH_DAYS from wp-config.php, copied when it is a literal number:
# 0 deletes posts and comments at once instead of moving them to the trash.
# Missing means WordPress's 30.
# EMPTY_TRASH_DAYS=30

# MEDIA_TRASH from wp-config.php, copied when it is a literal true or false:
# true moves media files to the trash instead of deleting them at once.
# MEDIA_TRASH=false

# Login rate limits (HyScribe's own; PHP WordPress has none). A client
# address with LOGIN_LIMIT_ADDRESS wrong guesses within LOGIN_LIMIT_WINDOW
# seconds is refused for the window, doubled for each refusal of the day
# before, up to a day. An account with LOGIN_LIMIT_ACCOUNT wrong guesses in
# the window is refused for the window, except from the last 8 addresses it
# logged in from. A refused guess is answered as a wrong password.
# LOGIN_LIMIT_ADDRESS=5
# LOGIN_LIMIT_ACCOUNT=10
# LOGIN_LIMIT_WINDOW=900

# Accounts one client address may create by registration in an hour. Past
# it, registration answers WordPress's own registration error and writes
# nothing. -1 turns the cap off.
# REGISTRATION_LIMIT_ADDRESS=3

# The mail relay (ADR 0016). Without SMTP_HOST no mail is sent. SMTP_TLS is
# starttls (required, the default), tls, or none for a relay on this
# machine only; SMTP_PORT defaults to 587, 465 or 25 by it. SMTP_USER and
# SMTP_PASSWORD log in with SMTP AUTH, never over none. MAIL_FROM is the
# sender address of every message; unset, wordpress@ and the site's host.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=wordpress@example.com

# The largest file an upload may be, in place of PHP's upload_max_filesize
# and post_max_size: bytes, or with a K, M or G suffix as in php.ini. The
# admin shows it wherever WordPress shows the maximum upload file size.
# UPLOAD_MAX_SIZE=64M

# Keys and salts, copied from wp-config.php so logins keep working.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# The limits an uploaded image is decoded within (ADR 0015), at the PHP
# oracle's ImageMagick policy by default. An image over one is kept with
# no sizes, as WordPress keeps an image its editor cannot open.
# IMAGE_MAX_BYTES=64M
# IMAGE_MAX_WIDTH=32000
# IMAGE_MAX_HEIGHT=32000
# IMAGE_MAX_AREA=256000000
# IMAGE_MAX_MEMORY=1G
