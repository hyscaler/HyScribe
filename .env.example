# HyScribe configuration. ./hyscribe setup writes .env from an existing
# site's wp-config.php; or copy this to .env next to the binary, then
# chmod 600 .env.
# Real environment variables override these values.

# Database (same values as wp-config.php)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=
DB_PREFIX=wp_
DB_CHARSET=utf8mb4

# HTTP listener. 127.0.0.1 keeps the site private until a proxy is in front.
BIND_HOST=127.0.0.1
PORT=8080
BEHIND_PROXY=false

# shadow: read only, never writes (default). primary: serves and writes.
MODE=shadow

# Existing sites only: the WordPress uploads folder, left where it is.
# UPLOADS_DIR=/var/www/wordpress/wp-content/uploads

# Overrides the site address stored in the database, like WP_HOME in
# wp-config.php. Useful to try a copy of a site on another address.
# WP_HOME=http://127.0.0.1:8080

# The public users REST endpoint (/wp-json/wp/v2/users), which lists every
# user with published posts to visitors, as WordPress does. off answers
# visitors as a site where no user has published posts.
REST_PUBLIC_USERS=on

# The wp-config.php constants capability checks read, copied from
# wp-config.php: true or false (1 or 0). Missing means the safer value
# shown. MULTISITE=true is refused: multisite networks are not supported.
# DISALLOW_UNFILTERED_HTML=true
# ALLOW_UNFILTERED_UPLOADS=false
# MULTISITE=false

# WP-Cron, copied from wp-config.php: true or false (1 or 0). In primary
# mode the service runs the due events of WordPress's core jobs once a
# minute, sharing PHP's doing_cron lock. DISABLE_WP_CRON=true turns that
# off; run ./hyscribe cron run from the system's cron instead.
# ALTERNATE_WP_CRON is accepted and ignored.
# DISABLE_WP_CRON=false
# ALTERNATE_WP_CRON=false

# Login rate limits (HyScribe's own; PHP WordPress has none). A client
# address with LOGIN_LIMIT_ADDRESS wrong guesses within LOGIN_LIMIT_WINDOW
# seconds is refused for the window, doubled for each refusal of the day
# before, up to a day. An account with LOGIN_LIMIT_ACCOUNT wrong guesses in
# the window is refused for the window, except from the last 8 addresses it
# logged in from. A refused guess is answered as a wrong password.
# LOGIN_LIMIT_ADDRESS=5
# LOGIN_LIMIT_ACCOUNT=10
# LOGIN_LIMIT_WINDOW=900

# Keys and salts, copied from wp-config.php so logins keep working.
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=
