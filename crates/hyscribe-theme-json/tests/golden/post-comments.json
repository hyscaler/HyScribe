{
    "name": "core/post-comments",
    "supports": {
        "html": false,
        "align": [
            "wide",
            "full"
        ],
        "typography": {
            "fontSize": true,
            "lineHeight": true,
            "__experimentalFontStyle": true,
            "__experimentalFontWeight": true,
            "__experimentalLetterSpacing": true,
            "__experimentalTextTransform": true,
            "__experimentalDefaultControls": {
                "fontSize": true
            }
        },
        "color": {
            "gradients": true,
            "link": true,
            "__experimentalDefaultControls": {
                "background": true,
                "text": true
            }
        },
        "inserter": false
    }
}
