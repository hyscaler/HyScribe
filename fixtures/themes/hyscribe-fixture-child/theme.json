{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"color": {
			"palette": [
				{ "color": "#FFFFFF", "name": "Base", "slug": "base" },
				{ "color": "#111111", "name": "Contrast", "slug": "contrast" },
				{ "color": "#2E7D32", "name": "Accent 1", "slug": "accent-1" },
				{ "color": "#F6CFF4", "name": "Accent 2", "slug": "accent-2" },
				{ "color": "#FF7043", "name": "Child accent", "slug": "child-accent" }
			]
		}
	},
	"styles": {
		"elements": {
			"link": {
				"color": { "text": "var:preset|color|accent-1" }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontWeight": "700" }
			}
		}
	},
	"templateParts": [
		{ "area": "footer", "name": "child-footer", "title": "Child Footer" }
	],
	"customTemplates": [
		{ "name": "child-wide", "postTypes": ["page"], "title": "Child Wide" }
	]
}
