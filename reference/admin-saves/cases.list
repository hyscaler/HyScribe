# The admin actions reference/admin-saves/golden.sh sends past their checks,
# as user 1, an administrator, with a valid nonce in the field given:
# case	method	target	body (- for none)	nonce action	nonce field
# User 801 is reference/action-checks/content.sql's author.
users-promote	GET	users.php?changeit=Change&new_role=editor&users[]=801	-	bulk-users	_wpnonce
users-promote-self	GET	users.php?changeit=Change&new_role=administrator&users[]=1	-	bulk-users	_wpnonce
users-promote-self-editor	GET	users.php?changeit=Change&new_role=editor&users[]=1	-	bulk-users	_wpnonce
users-promote-nobody	GET	users.php?changeit=Change&new_role=editor	-	bulk-users	_wpnonce
users-promote-referer	GET	users.php?changeit=Change&new_role=administrator&users[]=1&wp_http_referer=%2Fwp-admin%2Fusers.php%3Frole%3Dadministrator%26updated%3D1	-	bulk-users	_wpnonce
users-promote-post	POST	users.php	action=promote&new_role=administrator&users[]=1	bulk-users	_wpnonce
# Categories and tags (MVP 3.2), those that write nothing first. Term 801 is the content's tag.
terms-add-exists	POST	edit-tags.php	action=add-tag&screen=edit-category&taxonomy=category&post_type=post&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dcategory&tag-name=Uncategorized&slug=&parent=-1&description=	add-tag	_wpnonce_add-tag	edit-tags.php?taxonomy=category&error=1&message=4
terms-add-empty	POST	edit-tags.php	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&post_type=post&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dpost_tag%26paged%3D1&paged=2&tag-name=+&slug=&description=	add-tag	_wpnonce_add-tag
terms-delete-other	GET	edit-tags.php?action=delete&taxonomy=category&tag_ID=801&paged=3	-	delete-tag_801	_wpnonce	edit-tags.php?taxonomy=category&message=2
terms-bulk-missing	POST	edit-tags.php	action=delete&taxonomy=category&delete_tags%5B%5D=999&delete_tags%5B%5D=x&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dcategory%26message%3D1%26error%3D1	bulk-tags	_wpnonce	edit-tags.php?taxonomy=category&message=6
terms-edited-empty	POST	edit-tags.php	action=editedtag&tag_ID=1&taxonomy=category&_wp_http_referer=%2Fwp-admin%2Fterm.php%3Ftaxonomy%3Dcategory%26tag_ID%3D1%26post_type%3Dpost%26wp_http_referer%3D%252Fwp-admin%252Fedit-tags.php%253Ftaxonomy%253Dcategory&name=&slug=uncategorized&parent=-1&description=	update-tag_1	_wpnonce	term.php?taxonomy=category&tag_ID=1&post_type=post&wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dcategory&error=1&message=5
terms-edited-other	POST	edit-tags.php	action=editedtag&tag_ID=801&taxonomy=category&name=Other	update-tag_801	_wpnonce
ajax-add-exists	POST	admin-ajax.php	action=add-tag&screen=edit-category&taxonomy=category&post_type=post&tag-name=Uncategorized&slug=&parent=-1&description=	add-tag	_wpnonce_add-tag
ajax-add-empty	POST	admin-ajax.php	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&tag-name=&slug=	add-tag	_wpnonce_add-tag
ajax-add-missing-parent	POST	admin-ajax.php	action=add-tag&screen=edit-category&taxonomy=category&tag-name=Orphan&parent=999	add-tag	_wpnonce_add-tag
ajax-add-invalid-name	POST	admin-ajax.php	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&tag-name=%3Cb%3E%3C%2Fb%3E	add-tag	_wpnonce_add-tag
ajax-add-tag-exists	POST	admin-ajax.php	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&tag-name=tagged	add-tag	_wpnonce_add-tag
ajax-inline-empty	POST	admin-ajax.php	action=inline-save-tax&taxonomy=category&tax_ID=1&name=&slug=uncategorized	taxinlineeditnonce	_inline_edit
ajax-inline-other	POST	admin-ajax.php	action=inline-save-tax&taxonomy=category&tax_ID=801&name=Other&slug=other	taxinlineeditnonce	_inline_edit
ajax-inline-unchanged	POST	admin-ajax.php	action=inline-save-tax&taxonomy=category&tax_ID=1&name=Uncategorized&slug=uncategorized	taxinlineeditnonce	_inline_edit
ajax-delete-other	POST	admin-ajax.php	action=delete-tag&tag_ID=801&taxonomy=category	delete-tag_801	_ajax_nonce
ajax-delete-unknown	POST	admin-ajax.php	action=delete-tag&tag_ID=801&taxonomy=nope	delete-tag_801	_ajax_nonce
# Categories and tags that write, compared in the write oracle's tests.
terms-edited	POST	edit-tags.php	action=editedtag&tag_ID=801&taxonomy=post_tag&_wp_http_referer=%2Fwp-admin%2Fterm.php%3Ftaxonomy%3Dpost_tag%26tag_ID%3D801%26post_type%3Dpost&name=Renamed+tag&slug=renamed-tag&description=Now+%3Cem%3Edescribed%3C%2Fem%3E	update-tag_801	_wpnonce
ajax-inline-rename	POST	admin-ajax.php	action=inline-save-tax&taxonomy=post_tag&tax_ID=801&name=Quick+%26+named&slug=quick-named	taxinlineeditnonce	_inline_edit
ajax-add-tag	POST	admin-ajax.php	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&post_type=post&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dpost_tag&tag-name=Fresh+tag&slug=&description=About+it	add-tag	_wpnonce_add-tag
ajax-add-child	POST	admin-ajax.php	action=add-tag&screen=edit-category&taxonomy=category&post_type=post&tag-name=Child+category&slug=&parent=1&description=	add-tag	_wpnonce_add-tag
ajax-inline-duplicate	POST	admin-ajax.php	action=inline-save-tax&taxonomy=category&tax_ID=1&name=Uncategorized&slug=child-category	taxinlineeditnonce	_inline_edit
terms-add	POST	edit-tags.php	action=add-tag&screen=edit-category&taxonomy=category&post_type=post&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dcategory&tag-name=Added+here&slug=&parent=-1&description=Some+%3Cb%3Etext%3C%2Fb%3E	add-tag	_wpnonce_add-tag
ajax-delete-tag	POST	admin-ajax.php	action=delete-tag&tag_ID=801&taxonomy=post_tag	delete-tag_801	_ajax_nonce
