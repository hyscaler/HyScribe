# The admin actions reference/admin-saves/golden.sh sends past their checks,
# as user 1, an administrator, with a valid nonce in the field given:
# case	method	target	body (- for none)	nonce action	nonce field
# User 801 is reference/action-checks/content.sql's author.
users-promote	GET	users.php?changeit=Change&new_role=editor&users[]=801	-	bulk-users	_wpnonce
users-promote-self	GET	users.php?changeit=Change&new_role=administrator&users[]=1	-	bulk-users	_wpnonce
users-promote-self-editor	GET	users.php?changeit=Change&new_role=editor&users[]=1	-	bulk-users	_wpnonce
users-promote-nobody	GET	users.php?changeit=Change&new_role=editor	-	bulk-users	_wpnonce
users-promote-referer	GET	users.php?changeit=Change&new_role=administrator&users[]=1&wp_http_referer=%2Fwp-admin%2Fusers.php%3Frole%3Dadministrator%26updated%3D1	-	bulk-users	_wpnonce
users-promote-post	POST	users.php	action=promote&new_role=administrator&users[]=1	bulk-users	_wpnonce
users-dodelete	POST	users.php	action=dodelete&users[]=801&delete_option[801]=reassign&reassign_user[801]=1	delete-users	_wpnonce
users-dodelete-delete	POST	users.php	action=dodelete&users[]=801&users[]=1&delete_option[801]=delete&delete_option[1]=delete	delete-users	_wpnonce
users-dodelete-missing	POST	users.php	action=dodelete&users[]=801&delete_option[801]=reassign&reassign_user[801]=&wp_http_referer=%2Fwp-admin%2Fusers.php%3Frole%3Dauthor	delete-users	_wpnonce
users-dodelete-self	POST	users.php	action=dodelete&users[]=1&delete_option[1]=delete	delete-users	_wpnonce
users-dodelete-nobody	POST	users.php	action=dodelete&delete_option[801]=delete	delete-users	_wpnonce
users-resetpassword	GET	users.php?action=resetpassword&users[]=801&users[]=1	-	bulk-users	_wpnonce
users-resetpassword-self	GET	users.php?action=resetpassword&users[]=1	-	bulk-users	_wpnonce
users-resetpassword-nobody	GET	users.php?action=resetpassword	-	bulk-users	_wpnonce
user-new-create	POST	user-new.php	action=createuser&user_login=newbie&email=newbie%40example.test&first_name=New&last_name=Bie&url=&pass1=Pass+1&pass2=Pass+1&role=author&send_user_notification=1&createuser=Add+User	create-user	_wpnonce_create-user
user-new-quiet	POST	user-new.php	action=createuser&user_login=quiet&email=quiet%40example.test&pass1=Pass+1&pass2=Pass+1&role=&createuser=Add+User	create-user	_wpnonce_create-user
user-new-bad-role	POST	user-new.php	action=createuser&user_login=bad&email=bad%40example.test&pass1=a&pass2=a&role=bogus	create-user	_wpnonce_create-user
user-edit-update	POST	user-edit.php	action=update&user_id=801&email=other%40example.test&nickname=Other&display_name=Other&role=editor&pass1=&pass2=&wp_http_referer=%2Fwp-admin%2Fusers.php%3Frole%3Dauthor%26update%3Dx	update-user_801	_wpnonce
user-edit-self	POST	user-edit.php	action=update&user_id=1&email=admin%40default-install.test&nickname=admin&display_name=admin&pass1=&pass2=	update-user_1	_wpnonce
profile-no-id	POST	profile.php	action=update&email=admin%40default-install.test&nickname=admin&display_name=admin&pass1=&pass2=	update-user_1	_wpnonce
profile-update	POST	profile.php	action=update&user_id=1&email=admin%40default-install.test&nickname=admin&display_name=admin&url=http%3A%2F%2Fdefault-install.test&pass1=&pass2=&admin_color=modern&admin_bar_front=1	update-user_1	_wpnonce
profile-email	POST	profile.php	action=update&user_id=1&email=new%40example.test&nickname=admin&display_name=admin&pass1=&pass2=	update-user_1	_wpnonce
profile-email-taken	POST	profile.php	action=update&user_id=1&email=other%40example.test&nickname=admin&display_name=admin&pass1=&pass2=	update-user_1	_wpnonce
profile-password	POST	profile.php	action=update&user_id=1&email=admin%40default-install.test&nickname=admin&display_name=admin&pass1=New+pass&pass2=New+pass	update-user_1	_wpnonce
color-scheme	POST	admin-ajax.php	action=save-user-color-scheme&color_scheme=ocean	save-color-scheme	nonce
destroy-sessions-self	POST	admin-ajax.php	action=destroy-sessions&user_id=1	update-user_1	nonce
destroy-sessions-other	POST	admin-ajax.php	action=destroy-sessions&user_id=801	update-user_801	nonce
destroy-sessions-missing	POST	admin-ajax.php	action=destroy-sessions&user_id=999	update-user_999	nonce
send-password-reset	POST	admin-ajax.php	action=send-password-reset&user_id=801	reset-password-for-801	nonce
send-password-reset-missing	POST	admin-ajax.php	action=send-password-reset&user_id=999	reset-password-for-999	nonce
