# The admin actions reference/admin-saves/golden.sh sends past their checks,
# as user 1, an administrator, with a valid nonce in the field given:
# case	method	target	body (- for none)	nonce action	nonce field
# User 801 is reference/action-checks/content.sql's author.
users-promote	GET	users.php?changeit=Change&new_role=editor&users[]=801	-	bulk-users	_wpnonce
users-promote-self	GET	users.php?changeit=Change&new_role=administrator&users[]=1	-	bulk-users	_wpnonce
users-promote-self-editor	GET	users.php?changeit=Change&new_role=editor&users[]=1	-	bulk-users	_wpnonce
users-promote-nobody	GET	users.php?changeit=Change&new_role=editor	-	bulk-users	_wpnonce
users-promote-referer	GET	users.php?changeit=Change&new_role=administrator&users[]=1&wp_http_referer=%2Fwp-admin%2Fusers.php%3Frole%3Dadministrator%26updated%3D1	-	bulk-users	_wpnonce
users-promote-post	POST	users.php	action=promote&new_role=administrator&users[]=1	bulk-users	_wpnonce
# Comment 1 moderated in turn: moderate-* cases write or answer with the
# time or the request's nonce, so the Rust test replays them in order
# (saves/tests/comments.rs); comments-* cases write nothing.
comments-referer	GET	edit-comments.php?action=approve&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dmoderated	-	bulk-comments	_wpnonce
comments-bulk-unknown	GET	edit-comments.php?action=bogus&delete_comments[]=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php	-	bulk-comments	_wpnonce
comments-bulk-string	GET	edit-comments.php?action=approve&delete_comments=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php	-	bulk-comments	_wpnonce
moderate-bulk-bare	GET	edit-comments.php?action=approve	-	bulk-comments	_wpnonce
moderate-bulk-unapprove	GET	edit-comments.php?action=unapprove&delete_comments[]=1&delete_comments[]=999&paged=2&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fapproved%3D1%26paged%3D3	-	bulk-comments	_wpnonce
moderate-bulk-approve	GET	edit-comments.php?action=approve&ids=1,999&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php	-	bulk-comments	_wpnonce
moderate-bulk-spam	POST	edit-comments.php	action=spam&delete_comments[]=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dall	bulk-comments	_wpnonce
moderate-bulk-unspam	GET	edit-comments.php?doaction=undo&action=unspam&ids=1	-	bulk-comments	_wpnonce
moderate-bulk-trash	GET	edit-comments.php?action=trash&delete_comments[]=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php	-	bulk-comments	_wpnonce
moderate-bulk-untrash	GET	edit-comments.php?action=untrash&ids=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dtrash	-	bulk-comments	_wpnonce
moderate-unapprove	GET	comment.php?action=unapprovecomment&c=1	-	approve-comment_1	_wpnonce
moderate-approve	GET	comment.php?action=approvecomment&c=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dmoderated%26approved%3D2	-	approve-comment_1	_wpnonce
moderate-spam	GET	comment.php?action=spamcomment&c=1&noredir=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php	-	delete-comment_1	_wpnonce
moderate-unspam	GET	comment.php?action=unspamcomment&c=1&_wp_original_http_referer=%2Fwp-admin%2Fedit-comments.php%3Fp%3D1	-	delete-comment_1	_wpnonce
moderate-trash	POST	comment.php	action=trashcomment&c=1&_wp_http_referer=%2Fwp-admin%2Fcomment.php%3Faction%3Dtrash%26c%3D1	delete-comment_1	_wpnonce
moderate-untrash	GET	comment.php?action=untrashcomment&c=1	-	delete-comment_1	_wpnonce
moderate-delete	POST	comment.php	deletecomment=1&c=1&_wp_http_referer=%2Fwp-admin%2Fedit-comments.php%3Ffrom%3Dcomment.php	delete-comment_1	_wpnonce
moderate-untrash-again	GET	comment.php?action=untrashcomment&c=1&noredir=1	-	delete-comment_1	_wpnonce
moderate-dim-hold	POST	admin-ajax.php	action=dim-comment&id=1&new=unapproved	approve-comment_1	_ajax_nonce
moderate-dim-same	POST	admin-ajax.php	action=dim-comment&id=1&new=unapproved	approve-comment_1	_ajax_nonce
moderate-dim-approve	POST	admin-ajax.php	action=dim-comment&id=1&new=approved	approve-comment_1	_ajax_nonce
moderate-ajax-trash	POST	admin-ajax.php	action=delete-comment&id=1&trash=1&_total=21&_per_page=20&_page=1&_url=http%3A%2F%2F127.0.0.1%3A8081%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dall	delete-comment_1	_ajax_nonce
moderate-ajax-trash-again	POST	admin-ajax.php	action=delete-comment&id=1&trash=1	delete-comment_1	_ajax_nonce
moderate-ajax-untrash	POST	admin-ajax.php	action=delete-comment&id=1&untrash=1&comment_status=trash&_total=3&_per_page=1&_page=1&_url=http%3A%2F%2F127.0.0.1%3A8081%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dapproved%26p%3D1	delete-comment_1	_ajax_nonce
moderate-ajax-spam	POST	admin-ajax.php	action=delete-comment&id=1&spam=1&_total=7&_per_page=20&_page=1&_url=http%3A%2F%2F127.0.0.1%3A8081%2Fwp-admin%2Fedit-comments.php%3Fcomment_type%3Dcomment	delete-comment_1	_ajax_nonce
moderate-ajax-spam-again	POST	admin-ajax.php	action=delete-comment&id=1&spam=1	delete-comment_1	_ajax_nonce
moderate-ajax-untrash-spam	POST	admin-ajax.php	action=delete-comment&id=1&untrash=1	delete-comment_1	_ajax_nonce
moderate-ajax-unspam	POST	admin-ajax.php	action=delete-comment&id=1&unspam=1&_total=4&_per_page=20&_page=1&_url=http%3A%2F%2F127.0.0.1%3A8081%2Fwp-admin%2Fedit-comments.php%3Fcomment_type%3Dcomment	delete-comment_1	_ajax_nonce
moderate-ajax-unspam-live	POST	admin-ajax.php	action=delete-comment&id=1&unspam=1	delete-comment_1	_ajax_nonce
moderate-ajax-spam-quiet	POST	admin-ajax.php	action=delete-comment&id=1&spam=1	delete-comment_1	_ajax_nonce
moderate-dim-from-spam	POST	admin-ajax.php	action=dim-comment&id=1&new=approved	approve-comment_1	_ajax_nonce
moderate-ajax-delete-to-trash	POST	admin-ajax.php	action=delete-comment&id=1&delete=1&_total=2&_per_page=1&_page=1&_url=http%3A%2F%2F127.0.0.1%3A8081%2Fwp-admin%2Fedit-comments.php%3Fcomment_status%3Dmoderated	delete-comment_1	_ajax_nonce
moderate-ajax-untrash-quiet	POST	admin-ajax.php	action=delete-comment&id=1&untrash=1	delete-comment_1	_ajax_nonce
comments-ajax-none	POST	admin-ajax.php	action=delete-comment&id=1	delete-comment_1	_ajax_nonce
comments-ajax-dim-missing	POST	admin-ajax.php	action=dim-comment&id=999	approve-comment_999	_ajax_nonce
