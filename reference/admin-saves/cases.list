# The posts and pages lists: post 801 is the author's, 802 the
# administrator's in the Trash; a lock is user 801's, fresh. Each case starts
# from the database as it was, and its screen after is where it redirects.
# Restored
posts-trash	GET	post.php?post=1&action=trash	-	trash-post_1	_wpnonce	->
