#
# The block editor's saves with `meta` and of password protected and sticky
# posts, which reference/rest/golden.sh records as editor-meta.tsv over the
# default install as editor-meta.sql leaves it: the footnotes block's meta
# in saves of posts, pages and patterns (with the revisions it makes), what
# PHP refuses of a footnotes value, meta that is not registered, and a
# password protected post made sticky. Each as every identity, the database
# put back after each; the editor's PUT as a POST with X-HTTP-Method-Override.
POST	/index.php?rest_route=/wp/v2/posts/9701&_locale=user	json,restore,put	{"id":9701,"meta":{"footnotes":"[{\"content\":\"A <b>note</b>\",\"id\":\"n1\"}]"},"content":"<!-- wp:paragraph -->\n<p>No notes yet.<sup data-fn=\"n1\" class=\"fn\"><a href=\"#n1\" id=\"n1-link\">1</a></sup></p>\n<!-- /wp:paragraph -->"}
POST	/index.php?rest_route=/wp/v2/posts/9701&_locale=user	json,restore,put	{"id":9701,"meta":{"footnotes":"[{\"content\":\"Bad <script>x()</script><em>ok</em> café / <a href=\\\"https://x.test/\\\" onclick=\\\"y()\\\">l</a>\",\"id\":\"AB 12!\"},{\"content\":\"\",\"id\":\"e\"},{\"content\":\"no id\"},{\"id\":\"no-content\"},{\"content\":\"0\",\"id\":\"zero\"},{\"content\":\"kept\",\"id\":7}]"}}
POST	/index.php?rest_route=/wp/v2/posts/9701&_locale=user	json,restore,put	{"id":9701,"meta":{"footnotes":"not json"}}
POST	/index.php?rest_route=/wp/v2/posts/9701&_locale=user	json,restore,put	{"id":9701,"meta":{"footnotes":"{\"a\":{\"content\":\"Keyed\",\"id\":\"k\"},\"b\":\"text\",\"c\":[]}"}}
