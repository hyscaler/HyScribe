#
# The block editor's saves (MVP 5.2) as its JavaScript sends them, which
# reference/rest/golden.sh records as editor-saves.tsv over the default
# install as editor-saves.sql leaves it: core-data's saveEntityRecord() of
# savePost(), a POST with X-HTTP-Method-Override: PUT (flag put) to the REST
# URL with _locale=user and the JSON of the post's ID, its edits and its
# content; the move to the trash, deleteEntityRecord(), the same POST with
# X-HTTP-Method-Override: DELETE and no body. Each as every identity, the
# database put back after each: saving, publishing, scheduling and
# submitting a draft, updating, redating, switching to draft, unscheduling,
# private and password protected posts, sticky posts, featured images,
# categories and tags, the slug, the excerpt, discussion, post formats, a
# page's parent, template and order, and the trash; and a PDF as the
# featured image and templates check_template() refuses or keeps.
POST	/index.php?rest_route=/wp/v2/posts/9601&_locale=user	json,restore,put	{"id":9601,"title":"First draft","content":"<!-- wp:paragraph -->\n<p>Drafted in the editor.</p>\n<!-- /wp:paragraph -->","status":"draft"}
