POST	/index.php?rest_route=/wp/v2/templates&_locale=user	json,restore	{"slug":"tag-tagged","title":"Tag: Tagged","description":"Template for Tagged","status":"publish","is_wp_suggestion":true,"content":"<!-- wp:query-title {\"type\":\"archive\"} /-->"}
POST	/index.php?rest_route=/wp/v2/templates&_locale=user	json,restore	{"slug":"author-admin","title":"Author: admin","description":"Template for admin","status":"publish","is_wp_suggestion":true,"content":"x"}
