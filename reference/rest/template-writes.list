#
# The site editor's templates' and template parts' writes (MVP 4.3) that
# reference/rest/golden.sh records as template-writes.tsv, over
# template-writes.sql: each request sent with its body as every identity,
# the database put back after each.
# Creates, theme files customised, customised templates updated, reverted
# (`source` theme), trashed and deleted, the checks PHP makes first, the
# arguments of each type, templates named after a page, a part's area kept
# on an update, and a template part found by its ID in any area.
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"my-template","title":"My template","content":"<!-- wp:paragraph -->\n<p>Mine</p>\n<!-- /wp:paragraph -->","description":"Made here"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"page-about","title":{"raw":"About"},"content":{"raw":"<!-- wp:post-content /-->"},"status":"draft","author":702,"is_wp_suggestion":true}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"my-custom","title":"Again","content":"<!-- wp:post-title /-->"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"for-four","theme":"twentytwentyfour","title":"Four"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"plain"}
POST	/?rest_route=/wp/v2/templates	json,restore	{}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"bad slug"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"by-nobody","title":"Nobody","author":999}
POST	/?rest_route=/wp/v2/template-parts	json,restore	{"slug":"my-sidebar","title":"My sidebar","area":"header","content":"<!-- wp:paragraph -->\n<p>Side</p>\n<!-- /wp:paragraph -->"}
POST	/?rest_route=/wp/v2/template-parts	json,restore	{"slug":"odd-part","title":"Odd","area":"bogus"}
POST	/?rest_route=/wp/v2/template-parts	json,restore	{"slug":"no-area","title":"No area"}
POST	/?rest_route=/wp/v2/templates/twentytwentyfive//page	json,restore	{"content":"<!-- wp:paragraph -->\n<p>Customised</p>\n<!-- /wp:paragraph -->"}
POST	/?rest_route=/wp/v2/templates/twentytwentyfive//search	json,restore	{"title":"Search results"}
PUT	/?rest_route=/wp/v2/template-parts/twentytwentyfive//footer	json,restore	{"content":"<!-- wp:paragraph -->\n<p>Foot</p>\n<!-- /wp:paragraph -->"}
POST	/?rest_route=/wp/v2/templates/twentytwentyfive//index	json,restore	{"title":"Index again","content":"<!-- wp:paragraph -->\n<p>Changed</p>\n<!-- /wp:paragraph -->"}
PATCH	/?rest_route=/wp/v2/template-parts/twentytwentyfive//header	json,restore	{"area":"footer","description":"Moved"}
POST	/?rest_route=/wp/v2/templates/twentytwentyfive//page-no-title	json,restore	{"source":"theme"}
POST	/?rest_route=/wp/v2/templates/twentytwentyfive//nope	json,restore	{"title":"Nope"}
DELETE	/?rest_route=/wp/v2/templates/twentytwentyfive//my-custom	restore
DELETE	/?rest_route=/wp/v2/templates/twentytwentyfive//my-custom&force=true	restore
DELETE	/?rest_route=/wp/v2/templates/twentytwentyfive//page	restore
DELETE	/?rest_route=/wp/v2/templates/twentytwentyfive//archive	restore
DELETE	/?rest_route=/wp/v2/template-parts/twentytwentyfive//header&force=1	restore
POST	/?rest_route=/wp/v2/template-parts	json,restore	{"slug":"bad-area","title":"Bad","area":5}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"with-area","title":"With area","area":[]}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"page-about-us","title":"About","content":"x"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"page-about-us","description":"About a page","content":"x"}
POST	/?rest_route=/wp/v2/templates	json,restore	{"slug":"page-about-us","title":"page-about-us","content":"x"}
POST	/?rest_route=/wp/v2/template-parts	json,restore	{"slug":"page-about-us","content":"x"}
PATCH	/?rest_route=/wp/v2/template-parts/twentytwentyfive//header	json,restore	{"title":"Head"}
PATCH	/?rest_route=/wp/v2/template-parts/twentytwentyfive//side-part	json,restore	{"title":"Side"}
GET	/?rest_route=/wp/v2/template-parts&wp_id=721&area=footer&_fields=id,area
# A custom template made from the editor: the "Add template" dialog, with its suggestions.
POST	/index.php?rest_route=/wp/v2/templates&_locale=user	json,restore	{"slug":"wp-custom-template-landing-page","title":"Landing page","description":"","status":"publish","is_wp_suggestion":false,"content":""}
POST	/index.php?rest_route=/wp/v2/templates&_locale=user	json,restore	{"slug":"wp-custom-template-landing-page","title":"Landing page","description":"For landing","status":"publish","content":"<!-- wp:post-title /-->\n\n<!-- wp:post-content /-->"}
