GET	/?rest_route=/wp/v2/sidebars/nope
GET	/?rest_route=/wp/v2/sidebars&_fields=id,widgets
GET	/?rest_route=/wp/v2/sidebars&_embed
GET	/?rest_route=/wp/v2/widgets
GET	/?rest_route=/wp/v2/widgets&context=edit
GET	/?rest_route=/wp/v2/widgets&context=embed
