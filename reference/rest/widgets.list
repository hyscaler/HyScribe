GET	/?rest_route=/wp/v2/widgets/nope
GET	/?rest_route=/wp/v2/widgets&_fields=id,instance.raw
GET	/?rest_route=/wp/v2/widgets&_embed
GET	/?rest_route=/wp/v2/widget-types
