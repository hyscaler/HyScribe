GET	/?rest_route=/wp/v2/widget-types/recent-posts&context=embed
GET	/?rest_route=/wp/v2/widget-types/nope
GET	/?rest_route=/wp/v2/widget-types&_fields=id,name
OPTIONS	/?rest_route=/wp/v2/sidebars
