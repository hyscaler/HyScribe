# The writes the switch-back suite makes in HyScribe, in order, over a fresh
# default install (crates/hyscribe/tests/switch_back.rs), before
# reference/switch-back/run.sh serves the database with PHP WordPress:
# case	user (admin or visitor)	method	path	body (- for none)	nonce action (- for none)	nonce field	status
# The dashboard: its Quick Draft auto-draft (post 4), saved, and the screen's state.
dashboard	admin	GET	/hs-admin/	-	-	-	200
quickdraft	admin	POST	/hs-admin/post	action=post-quickdraft-save&post_ID=4&post_type=post&post_title=Switch+back+draft&content=Drafted+in+HyScribe.	add-post	_wpnonce	200
welcome	admin	POST	/hs-admin/admin-ajax	action=update-welcome-panel&visible=0	welcome-panel-nonce	welcomepanelnonce	200
closed-boxes	admin	POST	/hs-admin/admin-ajax	action=closed-postboxes&closed=dashboard_activity&hidden=dashboard_primary&page=dashboard	closedpostboxes	closedpostboxesnonce	200
box-order	admin	POST	/hs-admin/admin-ajax	action=meta-box-order&order[normal]=dashboard_quick_press,dashboard_site_health&order[side]=dashboard_right_now&page_columns=2&page=dashboard	meta-box-order	_ajax_nonce	200
hidden-columns	admin	POST	/hs-admin/admin-ajax	action=hidden-columns&hidden=author&page=edit-post	screen-options-nonce	screenoptionnonce	200
per-page	admin	POST	/hs-admin/edit	wp_screen_options[option]=edit_post_per_page&wp_screen_options[value]=5	screen-options-nonce	screenoptionnonce	302
# Categories and tags: a category (term 2) added with Ajax; post 1's Quick Edit adds tags 3 and 4.
add-category	admin	POST	/hs-admin/admin-ajax	action=add-tag&screen=edit-category&taxonomy=category&post_type=post&tag-name=Switch+Category&slug=&parent=-1&description=	add-tag	_wpnonce_add-tag	200
inline-post	admin	POST	/hs-admin/admin-ajax	action=inline-save&post_ID=1&post_type=post&screen=edit-post&post_view=list&post_status=&edit_date=&post_title=Hello+again&post_name=hello-again&mm=11&jj=16&aa=2026&hh=08&mn=08&ss=15&hidden_mm=11&hidden_jj=16&hidden_aa=2026&hidden_hh=08&hidden_mn=08&post_author=1&post_password=&post_category[]=0&post_category[]=1&post_category[]=2&tax_input[post_tag]=Switch,+Back&comment_status=open&ping_status=open&_status=publish&sticky=sticky&post_format=0	inlineeditnonce	_inline_edit	200
inline-page	admin	POST	/hs-admin/admin-ajax	action=inline-save&post_ID=2&post_type=page&screen=edit-page&post_view=list&post_status=&edit_date=&post_title=Sample+Page+Edited&post_name=sample-page&mm=11&jj=16&aa=2026&hh=08&mn=08&ss=15&hidden_mm=11&hidden_jj=16&hidden_aa=2026&hidden_hh=08&hidden_mn=08&post_author=1&post_password=&post_parent=0&menu_order=3&page_template=default&_status=publish	inlineeditnonce	_inline_edit	200
add-tag	admin	POST	/hs-admin/edit-tags	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&post_type=post&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dpost_tag&tag-name=Form+tag&slug=&description=Added+by+the+form	add-tag	_wpnonce_add-tag	302
add-doomed	admin	POST	/hs-admin/admin-ajax	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&post_type=post&tag-name=Doomed+tag&slug=&description=	add-tag	_wpnonce_add-tag	200
add-bulk-doomed	admin	POST	/hs-admin/admin-ajax	action=add-tag&screen=edit-post_tag&taxonomy=post_tag&post_type=post&tag-name=Bulk+doomed&slug=&description=	add-tag	_wpnonce_add-tag	200
rename-tag	admin	POST	/hs-admin/admin-ajax	action=inline-save-tax&taxonomy=post_tag&tax_ID=5&name=Renamed+tag&slug=renamed-tag	taxinlineeditnonce	_inline_edit	200
edit-category	admin	POST	/hs-admin/edit-tags	action=editedtag&tag_ID=2&taxonomy=category&_wp_http_referer=%2Fwp-admin%2Fterm.php%3Ftaxonomy%3Dcategory%26tag_ID%3D2&name=Switch+Category&slug=switch-category&parent=-1&description=Described+in+HyScribe	update-tag_2	_wpnonce	302
delete-tag	admin	POST	/hs-admin/admin-ajax	action=delete-tag&tag_ID=6&taxonomy=post_tag	delete-tag_6	_ajax_nonce	200
bulk-delete-tag	admin	POST	/hs-admin/edit-tags	action=delete&taxonomy=post_tag&delete_tags[]=7&_wp_http_referer=%2Fwp-admin%2Fedit-tags.php%3Ftaxonomy%3Dpost_tag	bulk-tags	_wpnonce	302
# Posts: Bulk Edit (tag 8), trash and restore, a page trashed and the trash emptied, a new privacy policy page.
bulk-edit	admin	GET	/hs-admin/edit?s=&post_status=all&post_type=post&action=edit&m=0&cat=0&paged=1&post_view=list&screen=edit-post&mode=list&bulk_edit=Update&post[]=1&post[]=4&post_category[]=0&indeterminate_post_category[]=1&indeterminate_post_category[]=2&tax_input[post_tag]=Bulk+tag&post_author=-1&comment_status=&ping_status=&_status=-1&post_format=-1&sticky=-1	-	bulk-posts	_wpnonce	302
trash-post	admin	GET	/hs-admin/post?post=4&action=trash	-	trash-post_4	_wpnonce	302
untrash-post	admin	GET	/hs-admin/post?post=4&action=untrash	-	untrash-post_4	_wpnonce	302
trash-page	admin	GET	/hs-admin/edit?post_type=page&action=trash&post[]=3	-	bulk-posts	_wpnonce	302
empty-trash	admin	GET	/hs-admin/edit?post_status=trash&post_type=page&delete_all=Empty+Trash&action=-1	-	bulk-posts	_wpnonce	302
privacy-page	admin	POST	/hs-admin/options-privacy	action=create-privacy-page	create-privacy-page	_wpnonce	302
# Comments: a visitor's (2, held) and the administrator's (3) from the front end, moderated, replied to (4) and edited.
visitor-comment	visitor	POST	/wp-comments-post.php	comment_post_ID=1&author=Ann&email=ann%40example.test&url=&comment=A+visitor%27s+comment.	-	-	302
admin-comment	admin	POST	/wp-comments-post.php	comment_post_ID=1&comment=The+administrator%27s+comment.	-	-	302
approve	admin	POST	/hs-admin/admin-ajax	action=dim-comment&id=2&new=approved	approve-comment_2	_ajax_nonce	200
reply	admin	POST	/hs-admin/admin-ajax	action=replyto-comment&comment_ID=2&comment_post_ID=1&content=A+reply+from+the+admin.&position=-1&checkbox=1&mode=detail&p=	replyto-comment	_ajax_nonce-replyto-comment	200
quick-edit-comment	admin	POST	/hs-admin/admin-ajax	action=edit-comment&comment_ID=4&comment_post_ID=1&content=A+reply+edited+in+Quick+Edit.&status=0&position=-1&checkbox=1&mode=detail&p=	replyto-comment	_ajax_nonce-replyto-comment	200
edit-comment	admin	POST	/hs-admin/comment	action=editedcomment&comment_ID=2&comment_post_ID=1&newcomment_author=Ann+B&newcomment_author_email=ann%40example.test&newcomment_author_url=&content=A+visitor%27s+comment%2C+edited+on+the+screen.&comment_status=1&aa=2026&mm=11&jj=16&hh=09&mn=30&ss=00&hidden_aa=2026&hidden_mm=11&hidden_jj=16&hidden_hh=09&hidden_mn=30	update-comment_2	_wpnonce	302
spam	admin	POST	/hs-admin/admin-ajax	action=delete-comment&id=3&spam=1	delete-comment_3	_ajax_nonce	200
unspam	admin	POST	/hs-admin/admin-ajax	action=delete-comment&id=3&unspam=1	delete-comment_3	_ajax_nonce	200
trash-comment	admin	POST	/hs-admin/comment	action=trashcomment&c=3	delete-comment_3	_wpnonce	302
delete-comment	admin	POST	/hs-admin/comment	deletecomment=1&c=3	delete-comment_3	_wpnonce	302
unapprove-bulk	admin	GET	/hs-admin/edit-comments?action=unapprove&delete_comments[]=1	-	bulk-comments	_wpnonce	302
approve-again	admin	GET	/hs-admin/comment?action=approvecomment&c=1	-	approve-comment_1	_wpnonce	302
# Users: user 2 added, edited, its role changed and a reset link made; user 3 added, given post 4, deleted with it reassigned.
add-user	admin	POST	/hs-admin/user-new	action=createuser&user_login=switchback&email=switchback%40example.test&first_name=Switch&last_name=Back&url=&pass1=Switch+back+1%21&pass2=Switch+back+1%21&role=author&createuser=Add+User	create-user	_wpnonce_create-user	302
edit-user	admin	POST	/hs-admin/user-edit	action=update&user_id=2&email=switchback%40example.test&first_name=Switch&last_name=Back&nickname=Switcher&display_name=Switcher&role=editor&description=Edited+in+HyScribe.&pass1=&pass2=	update-user_2	_wpnonce	302
promote	admin	GET	/hs-admin/users?changeit=Change&new_role=author&users[]=2	-	bulk-users	_wpnonce	302
reset-link	admin	GET	/hs-admin/users?action=resetpassword&users[]=2	-	bulk-users	_wpnonce	302
add-leaver	admin	POST	/hs-admin/user-new	action=createuser&user_login=leaver&email=leaver%40example.test&first_name=&last_name=&url=&pass1=Leaving+3%21&pass2=Leaving+3%21&role=author&createuser=Add+User	create-user	_wpnonce_create-user	302
give-post	admin	POST	/hs-admin/admin-ajax	action=inline-save&post_ID=4&post_type=post&screen=edit-post&post_view=list&post_status=&edit_date=&post_title=Switch+back+draft&post_name=&mm=11&jj=16&aa=2026&hh=08&mn=08&ss=15&hidden_mm=11&hidden_jj=16&hidden_aa=2026&hidden_hh=08&hidden_mn=08&post_author=3&post_password=&post_category[]=0&post_category[]=2&tax_input[post_tag]=Bulk+tag&comment_status=open&ping_status=open&_status=draft&post_format=0	inlineeditnonce	_inline_edit	200
delete-leaver	admin	POST	/hs-admin/users	action=dodelete&users[]=3&delete_option[3]=reassign&reassign_user[3]=1	delete-users	_wpnonce	302
color-scheme	admin	POST	/hs-admin/admin-ajax	action=save-user-color-scheme&color_scheme=ocean	save-color-scheme	nonce	200
profile	admin	POST	/hs-admin/profile	action=update&user_id=1&email=admin%40default-install.test&first_name=Ada&last_name=Admin&nickname=admin&display_name=Ada+Admin&url=http%3A%2F%2Fdefault-install.test&description=Saved+in+HyScribe.&pass1=&pass2=&admin_color=modern&admin_bar_front=1	update-user_1	_wpnonce	302
# Settings, the permalinks last.
general	admin	POST	/hs-admin/options	option_page=general&action=update&_wp_http_referer=%2Fwp-admin%2Foptions-general.php&blogname=Switch+Back+Site&blogdescription=Saved+by+HyScribe&site_icon=0&new_admin_email=admin%40default-install.test&default_role=subscriber&WPLANG=&timezone_string=UTC%2B0&date_format=F+j%2C+Y&date_format_custom=F+j%2C+Y&time_format=g%3Ai+a&time_format_custom=g%3Ai+a&start_of_week=1	general-options	_wpnonce	302
writing	admin	POST	/hs-admin/options	option_page=writing&action=update&_wp_http_referer=%2Fwp-admin%2Foptions-writing.php&default_category=2&default_post_format=0&mailserver_url=mail.example.com&mailserver_port=110&mailserver_login=login%40example.com&mailserver_pass=&default_email_category=1&ping_sites=https%3A%2F%2Frpc.pingomatic.com%2F	writing-options	_wpnonce	302
reading	admin	POST	/hs-admin/options	option_page=reading&action=update&_wp_http_referer=%2Fwp-admin%2Foptions-reading.php&show_on_front=posts&posts_per_page=5&posts_per_rss=7&rss_use_excerpt=1&blog_public=1	reading-options	_wpnonce	302
discussion	admin	POST	/hs-admin/options	option_page=discussion&action=update&_wp_http_referer=%2Fwp-admin%2Foptions-discussion.php&default_pingback_flag=1&default_ping_status=open&default_comment_status=open&require_name_email=1&close_comments_days_old=14&show_comments_cookies_opt_in=1&thread_comments=1&thread_comments_depth=4&comments_per_page=50&default_comments_page=newest&comment_order=asc&comments_notify=1&moderation_notify=1&wp_notes_notify=1&comment_previously_approved=1&comment_max_links=3&moderation_keys=&disallowed_keys=&show_avatars=1&avatar_rating=G&avatar_default=identicon	discussion-options	_wpnonce	302
media	admin	POST	/hs-admin/options	option_page=media&action=update&_wp_http_referer=%2Fwp-admin%2Foptions-media.php&thumbnail_size_w=160&thumbnail_size_h=160&thumbnail_crop=1&medium_size_w=300&medium_size_h=300&large_size_w=1024&large_size_h=1024&uploads_use_yearmonth_folders=1	media-options	_wpnonce	302
permalinks	admin	POST	/hs-admin/options-permalink	selection=%2F%25postname%25%2F&permalink_structure=%2F%25postname%25%2F&category_base=&tag_base=	update-permalink	_wpnonce	302
# The screen the save sends back to, which flushes the rewrite rules.
permalinks-screen	admin	GET	/hs-admin/options-permalink?settings-updated=true	-	-	-	200
