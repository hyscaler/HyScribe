scratch-rev	admin	POST	/?rest_route=/wp/v2/posts	{"title":"Revised over REST","content":"<!-- wp:paragraph -->\n<p>First version.</p>\n<!-- /wp:paragraph -->","status":"publish"}	wp_rest	X-WP-Nonce	201
scratch-rev-2	admin	POST	/?rest_route=/wp/v2/posts/%scratch-rev%	{"content":"<!-- wp:paragraph -->\n<p>Second version.</p>\n<!-- /wp:paragraph -->"}	wp_rest	X-WP-Nonce	200
scratch-rev-3	admin	POST	/?rest_route=/wp/v2/posts/%scratch-rev%	{"content":"<!-- wp:paragraph -->\n<p>Third version.</p>\n<!-- /wp:paragraph -->"}	wp_rest	X-WP-Nonce	200
older-revision	admin	GET	/?rest_route=/wp/v2/posts/%scratch-rev%/revisions&per_page=1&page=2	-	wp_rest	X-WP-Nonce	200
restore-revision	admin	GET	/hs-admin/revision?revision=%older-revision%&action=restore	-	restore-post_%older-revision%	_wpnonce	302
