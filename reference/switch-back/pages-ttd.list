# The screens and pages run.sh asks PHP WordPress for over the Theme Test Data (plain
# permalinks, so every address names an ID): user, path, status, text, as pages.list.
visitor	/?p=%rest-post%	200	Synced from REST.
visitor	/?p=%rest-post%	200	A REST post, updated
visitor	/?page_id=%rest-page%	200	A page written over REST.
visitor	/	200	Switch back over the Theme Test Data
admin	/wp-admin/edit.php?post_status=draft	200	A REST draft
admin	/wp-admin/edit.php?post_status=future	200	A REST future post
admin	/wp-admin/edit.php?post_status=trash	200	Trashed over REST
admin	/wp-admin/edit.php?post_type=wp_block	200	A REST pattern, renamed
admin	/wp-admin/edit-comments.php?comment_status=moderated	200	A visitor comment over the Theme Test Data.
admin	/wp-admin/options-general.php	200	Saved by HyScribe
admin	/wp-admin/upload.php?mode=list	200	REST image
admin	/wp-admin/upload.php?mode=list	200	REST png
