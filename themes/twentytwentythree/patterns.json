{
    "twentytwentythree/cta": {
        "title": "Call to action",
        "content": "\n<!-- wp:columns {\"align\":\"wide\"} -->\n<div class=\"wp-block-columns alignwide\">\n\t<!-- wp:column -->\n\t<div class=\"wp-block-column\">\n\t\t<!-- wp:paragraph {\"style\":{\"typography\":{\"lineHeight\":\"1.2\"}},\"fontSize\":\"x-large\"} -->\n\t\t<p class=\"has-x-large-font-size\" style=\"line-height:1.2\">Got any book recommendations?\t\t</p>\n\t\t<!-- /wp:paragraph -->\n\n\t\t<!-- wp:buttons -->\n\t\t<div class=\"wp-block-buttons\">\n\t\t\t<!-- wp:button {\"fontSize\":\"small\"} -->\n\t\t\t<div class=\"wp-block-button has-custom-font-size has-small-font-size\">\n\t\t\t\t<a class=\"wp-block-button__link wp-element-button\">\n\t\t\t\tGet In Touch\t\t\t\t</a>\n\t\t\t</div>\n\t\t\t<!-- /wp:button -->\n\t\t</div>\n\t\t<!-- /wp:buttons -->\n\t</div>\n\t<!-- /wp:column -->\n\n\t<!-- wp:column -->\n\t<div class=\"wp-block-column\">\n\t\t<!-- wp:separator {\"className\":\"is-style-wide\"} -->\n\t\t<hr class=\"wp-block-separator has-alpha-channel-opacity is-style-wide\"/>\n\t\t<!-- /wp:separator -->\n\t</div>\n\t<!-- /wp:column -->\n</div>\n<!-- /wp:columns -->\n",
        "description": "Left-aligned text with a CTA button and a separator.",
        "categories": [
            "featured"
        ]
    },
    "twentytwentythree/footer-default": {
        "title": "Default Footer",
        "content": "\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"}} -->\n<div class=\"wp-block-group\">\n\t<!-- wp:group {\"align\":\"wide\",\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\"}}},\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\"}} -->\n\t<div class=\"wp-block-group alignwide\" style=\"padding-top:var(--wp--preset--spacing--40)\">\n\t\t<!-- wp:site-title {\"level\":0} /-->\n\t\t<!-- wp:paragraph {\"align\":\"right\"} -->\n\t\t<p class=\"has-text-align-right\">\n\t\tProudly powered by <a href=\"https://wordpress.org\" rel=\"nofollow\">WordPress</a>\t\t</p>\n\t\t<!-- /wp:paragraph -->\n\t</div>\n\t<!-- /wp:group -->\n</div>\n<!-- /wp:group -->\n",
        "description": "Footer with site title and powered by WordPress.",
        "categories": [
            "footer"
        ]
    },
    "twentytwentythree/hidden-404": {
        "title": "Hidden 404",
        "content": "\n<!-- wp:spacer {\"height\":\"var(\\u002d\\u002dwp\\u002d\\u002dpreset\\u002d\\u002dspacing\\u002d\\u002d30)\"} -->\n<div style=\"height:var(--wp--preset--spacing--30)\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n\n<!-- wp:heading {\"level\":1,\"align\":\"wide\"} -->\n<h1 class=\"alignwide\">404</h1>\n<!-- /wp:heading -->\n\n<!-- wp:group {\"align\":\"wide\",\"layout\":{\"type\":\"default\"},\"style\":{\"spacing\":{\"margin\":{\"top\":\"5px\"}}}} -->\n<div class=\"wp-block-group alignwide\" style=\"margin-top:5px\">\n\t<!-- wp:paragraph -->\n\t<p>This page could not be found.</p>\n\t<!-- /wp:paragraph -->\n\n\t<!-- wp:search {\"label\":\"Search\",\"placeholder\":\"Search...\",\"showLabel\":false,\"width\":100,\"widthUnit\":\"%\",\"buttonText\":\"Search\",\"buttonUseIcon\":true,\"align\":\"center\"} /-->\n</div>\n<!-- /wp:group -->\n\n<!-- wp:spacer {\"height\":\"var(\\u002d\\u002dwp\\u002d\\u002dpreset\\u002d\\u002dspacing\\u002d\\u002d70)\"} -->\n<div style=\"height:var(--wp--preset--spacing--70)\" aria-hidden=\"true\" class=\"wp-block-spacer\"></div>\n<!-- /wp:spacer -->\n",
        "description": ""
    },
    "twentytwentythree/hidden-comments": {
        "title": "Hidden Comments",
        "content": "\n<!-- wp:group {\"layout\":{\"type\":\"constrained\"},\"style\":{\"spacing\":{\"padding\":{\"top\":\"var:preset|spacing|40\",\"right\":\"var:preset|spacing|40\",\"bottom\":\"var:preset|spacing|40\",\"left\":\"var:preset|spacing|40\"}}}} -->\n<div class=\"wp-block-group\" style=\"padding-top:var(--wp--preset--spacing--40);padding-right:var(--wp--preset--spacing--40);padding-bottom:var(--wp--preset--spacing--40);padding-left:var(--wp--preset--spacing--40)\">\n\t<!-- wp:comments -->\n\t<div class=\"wp-block-comments\">\n\t\t<!-- wp:heading {\"level\":2} -->\n\t\t<h2>Comments</h2>\n\t\t<!-- /wp:heading -->\n\n\t\t<!-- wp:comments-title {\"level\":3} /-->\n\n\t\t<!-- wp:comment-template -->\n\t\t\t<!-- wp:columns {\"style\":{\"spacing\":{\"margin\":{\"bottom\":\"var:preset|spacing|40\"}}}} -->\n\t\t\t<div class=\"wp-block-columns\" style=\"margin-bottom:var(--wp--preset--spacing--40)\">\n\t\t\t\t<!-- wp:column {\"width\":\"40px\"} -->\n\t\t\t\t<div class=\"wp-block-column\" style=\"flex-basis:40px\">\n\t\t\t\t\t<!-- wp:avatar {\"size\":40,\"style\":{\"border\":{\"radius\":\"20px\"}}} /-->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\n\t\t\t\t<!-- wp:column -->\n\t\t\t\t<div class=\"wp-block-column\">\n\t\t\t\t\t<!-- wp:comment-author-name /-->\n\n\t\t\t\t\t<!-- wp:group {\"style\":{\"spacing\":{\"margin\":{\"top\":\"0px\",\"bottom\":\"0px\"}}},\"layout\":{\"type\":\"flex\"}} -->\n\t\t\t\t\t<div class=\"wp-block-group\" style=\"margin-top:0px;margin-bottom:0px\">\n\t\t\t\t\t\t<!-- wp:comment-date /-->\n\t\t\t\t\t\t<!-- wp:comment-edit-link /-->\n\t\t\t\t\t</div>\n\t\t\t\t\t<!-- /wp:group -->\n\n\t\t\t\t\t<!-- wp:comment-content /-->\n\n\t\t\t\t\t<!-- wp:comment-reply-link /-->\n\t\t\t\t</div>\n\t\t\t\t<!-- /wp:column -->\n\t\t\t</div>\n\t\t\t<!-- /wp:columns -->\n\t\t<!-- /wp:comment-template -->\n\n\t\t<!-- wp:comments-pagination {\"paginationArrow\":\"arrow\",\"layout\":{\"type\":\"flex\",\"justifyContent\":\"space-between\"}} -->\n\t\t\t<!-- wp:comments-pagination-previous /-->\n\t\t\t<!-- wp:comments-pagination-numbers /-->\n\t\t\t<!-- wp:comments-pagination-next /-->\n\t\t<!-- /wp:comments-pagination -->\n\n\t<!-- wp:post-comments-form /-->\n\t</div>\n\t<!-- /wp:comments -->\n</div>\n<!-- /wp:group -->\n",
        "description": ""
    },
